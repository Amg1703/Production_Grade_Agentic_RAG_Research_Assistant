# THIS DOCKER IS DIVIDED INTO 2 THE BASE BUILD IMAGE AND THE RUN TIME CONTAINER 
# 
# THE IDEA IS TO BUILD A BASE IMAGE WITH EVERYTHING THAT IS NEEDED FOR THE PYTHON DEPENDENCIES AND THEN COPY THE BUILD VIRTUAL ENVIRONMENT  FILE
# INTO A SLIM LIGHTWEIGHT RUNTIME CONTAINER SINCE WE DONT NEED ALL THE MACHINERY TO RUN AN IMAGE THEREBY OPTIMIZINF MEMORY AND STORAGE
# AND GETTING FASTER RUNTIME AS IT RUNS ON SLIMMER IMAGE
# THE BUILD IMAGE IS THE PYTHON.3.12 WHICH INCLUDES UV THAT RUNS ON LINUX DEBIAN AND THEN WE COPY OUR LOCAL DEVELOPMENT VENV FILES LIKE YPORJECT AND UV.LOCL
# THEN SET ENV VARIABLES LIKE UV COMPILE BYTECODE AND LINK MODE TO CONVERT DEPENDECIES INTO BYTECODE AND NOT USE LINK MODE 
# AND THEN RUN UV SYNC WITH THE COPIED VENV FILE AND FREEZE THEM TO USE THOSE VENV FILES AND SET CACHE FOLDER INSIDE THE CONTAINER 

# WE ARE BUILDING THE IMAGE FROM GITHUB CONTAINER REGISTRY IN THE DOCKER HUB REGISTRY INSIDE ASTRAL-SG -> UV 
# WHERE UV IS THE PYTHON PACKAGE THAT IS BEING USED BY THIS REPOSITORY 
# THE IMAGE ALREADY COMES WITH UV AND THIS WILL BE THE BASE IMAGE 
FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim AS base 

# WE ARE SETTING THE WORKING DIRECTORY AS APP/ INSTEAD OF DOING CD .. 
WORKDIR /app

# COPY SOURCE FILE TARGET DIRECTORY 
# SO HERE WE ARE COPYING OUR LOCAL DEVELOPMENT PROJECT FILE'S PYPROJECT.TOML AND UV.LOCK TO THE WORKING DIRECTORY NAMELY /APP, the ./ means: /app
# THE PYPROJECT.TOML CONSISTS OF ALL THE PROJECT DEPENDENCY'S REQUIREMENT  
COPY pyproject.toml uv.lock ./

# WE ARE SETTING THE ENV VARIABLE FOR THE UV BASE IMAGE 
# UV_COMPILE_BYTECODE=1 - IS TO CONVERT THE .PY SOURCE CODE FILES -> TO COMPILED .PYC THEREBY CONVERTING THE SOURCE CODE INTO BYTECODE DURING IMAGE BUILD
# INSTEAD OF COMPILING SOURCE CODE TO BYTECODE WHEN THE CONTAINER STARTS THEREBY ITS DONE DURING THE DOCKER BUILD ITSELF 
# UV_LINK_MODE = COPY - IS BECAUSE UV USES DIFFERENT MECHANISM TO PUT PACKAGES INTO ENVIRONMENT AND ONE OPTION INCLUDES HARD LINKS
# BUT THE PROBLEM IS DOCKER'S BUILD CACHE AND DESTINATION ENVIRONMENT MAY EXIST ON DIFFERENT FILESYSTEM SO HARD LINK MIGHT NOT BE POSSIBLE 
# MEANING COPY FILES INSTEAD OF CREATING HARD LINKS 
# THIS PREVENTS WARNING/ ERRORS RELATED TO HARD LINKS 
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy

# TO RUN COMMANDS UV SYNC --FROZEN --NO-DEV AND THE REST ARE PASSED AS ARGUMENTS 
# --BIND-TYPE=CACHE - IS USED TO CREATE A PERSISTENT BUILD FOR UV CACHE SO UV HAS DOWNLOAD THE PACKAGES FROM THE INTERNET ONCE AND STORE IT IN CACHE
#                     THEN IT CAN AGAIN REUSE WHENEVER NEEDED INSTEAD OF DOWNLOADING FROM THE INTERNET AGAIN AND AGAIN AND THEN STORING IT IN THE TARGET DIRECTORY
#                     ./root/.cache/uv, WITHOUT THIS REBUILDING IMAGE WOULD INVOLVE DOWNLOADING THE PACKAGES AGAIN AND AGAIN FROM THE INTERNET 
# --BIND-TYPE=mount - IS USED TO COPY THE LOCAL DEVELOPMENT UV.LOCK TO THE DOCKER ENVIRONMENT CONTAINER'S DIRECTORY AND USE THE SAME UV.LOCK FILE
# --SOURCE=PYPROJECT.TOML - IS USED TO DO THE SAME AS ABOVE WHERE IT COPIED THE LOCAL DEVELOPMENT UV.LOCK FILE TO THE DOCKER ENVIRONMENT 
# UV SYNC --FROZEN --NO DEV - IS USED TO RUN UV SYNC TO SYNC UV WITH PROJECT DEPENDENICES AND VENV OF UV.LOCK AND PROJECT DEPENDENCIES OF PYPROJECT
#                             --FROZEN IS MEANS USE THE UV.LOCK FILE EXACTLY AS IT IS AND DO NOT MODIFY 
#                             -- NO DEV MEANS DO NOT INSTALL DEVELOPMENT DEPENDENCIES YOU MIGHT HAVE PRODUCTION: FASTAPI, UVICORN, ETC AND DEVELOPMENT: PYTEST, RUFF, MYPY
#                                WHICH THE PRODUCTION DOCKER IMAGE DOESNT NEED THEREBY NOT INSTALLING IT TO KEEP THE RUNTIME ENVIRONMENT SMALLER
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=uv.lock,target=uv.lock \
    --mount=type=bind,source=pyproject.toml,target=pyproject.toml \
    uv sync --frozen --no-dev

# WE ARE COPYING THE SOURCE CODE FROM THE LOCAL DEVELOPMENT SRC FOLDER INTO THE DOCKER CONTAINER WHERE IT WILL BE STORED IN THE /APP/SRC OF THE DOCKER CONTAINER 
COPY src /app/src

# RUNTIME STAGE: SLIM IMAGE WITH ONLY THE BUILT VIRTUALENV AND SOURCE CODE
FROM python:3.12-slim-bookworm AS final

ENV PYTHONUNBUFFERED=1
ARG VERSION=0.1.0
ENV APP_VERSION=$VERSION

WORKDIR /app

COPY --from=base /app /app

ENV PATH="/app/.venv/bin:$PATH"

EXPOSE 8000

CMD ["uvicorn", "src.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "4"]
